default_platform(:android)

platform :android do
  desc "Deploy to Firebase App Distribution"
  lane :distribute do
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID", "1:000000000000:android:REPLACE_ME"),
      service_credentials_file_content: ENV["FIREBASE_SERVICE_ACCOUNT"],
      groups: "qa-team, beta-testers",
      android_artifact_type: "AAB",
      release_notes: "Сборка #{ENV['GITHUB_RUN_NUMBER'] || 'local'}"
    )
  end
end
